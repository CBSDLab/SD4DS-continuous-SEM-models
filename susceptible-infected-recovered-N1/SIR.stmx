	<model_units>
		<unit name="People">
			<eqn/>
			<alias>person</alias>
			<alias>persons</alias>
		</unit>
		<unit name="Months">
			<eqn/>
			<alias>mo</alias>
			<alias>month</alias>
		</unit>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Susceptible">
				<eqn>5000</eqn>
				<inflow>Losing_Immunity</inflow>
				<outflow>Infection_Rate</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<stock name="Infected">
				<eqn>1</eqn>
				<inflow>Infection_Rate</inflow>
				<outflow>Recovery_Rate</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<stock name="Recovered">
				<eqn>0</eqn>
				<inflow>Recovery_Rate</inflow>
				<outflow>Losing_Immunity</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<flow name="Infection\nRate">
				<eqn>Susceptible*
Infected*
Contact_rate*
Infectivity/Total_population</eqn>
				<non_negative/>
				<units>People/Months</units>
			</flow>
			<flow name="Recovery\nRate">
				<eqn>Infected/Average_recovery_time</eqn>
				<non_negative/>
				<units>People/Months</units>
			</flow>
			<aux name="Average\nrecovery\ntime">
				<eqn>INIT(RANDOM(.125, 60))</eqn>
				<units>Months</units>
			</aux>
			<aux name="Total population">
				<eqn>INIT(RANDOM(4000, 1e6))</eqn>
				<units>People</units>
			</aux>
			<aux name="Infectivity">
				<eqn>INIT(RANDOM(0.01,  0.5))</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Contact rate">
				<eqn>INIT(RANDOM(5, 200))</eqn>
				<units>people/people/month</units>
			</aux>
			<aux name="Total susceptible">
				<eqn>Infected + Recovered + Susceptible</eqn>
				<isee:summing/>
			</aux>
			<aux name="R0">
				<eqn>Contact_rate*
Infectivity*
Average_recovery_time*
Total_susceptible/Total_population</eqn>
			</aux>
			<aux name="Observed\nSusceptible 1">
				<eqn>MAX(Susceptible + NORMAL(0, e_1), 0)</eqn>
			</aux>
			<aux name="e 1">
				<eqn>100</eqn>
			</aux>
			<aux name="Observed\nSusceptible 2">
				<eqn>MAX(Susceptible + NORMAL(0, e_2), 0)</eqn>
			</aux>
			<aux name="e 2">
				<eqn>100</eqn>
			</aux>
			<aux name="Observed\nSusceptible 3">
				<eqn>MAX(Susceptible + NORMAL(0, e_3), 0)</eqn>
			</aux>
			<aux name="e 3">
				<eqn>100</eqn>
			</aux>
			<aux name="Observed\nInfected 1">
				<eqn>MAX(Infected + NORMAL(0, e_4), 0)</eqn>
			</aux>
			<aux name="e 4">
				<eqn>50</eqn>
			</aux>
			<aux name="Observed\nInfected 2">
				<eqn>MAX(Infected + NORMAL(0, e_5), 0)</eqn>
			</aux>
			<aux name="e 5">
				<eqn>50</eqn>
			</aux>
			<aux name="Observed\nInfected 3">
				<eqn>MAX(Infected + NORMAL(0, e_6), 0)</eqn>
			</aux>
			<aux name="e 6">
				<eqn>50</eqn>
			</aux>
			<aux name="Observed\nRecovered 1">
				<eqn>MAX(Recovered + NORMAL(0, e_7), 0)</eqn>
			</aux>
			<aux name="e 7">
				<eqn>100</eqn>
			</aux>
			<aux name="Observed\nRecovered 2">
				<eqn>MAX(Recovered + NORMAL(0, e_8), 0)</eqn>
			</aux>
			<aux name="e 8">
				<eqn>100</eqn>
			</aux>
			<aux name="Observed\nRecovered 3">
				<eqn>MAX(Recovered + NORMAL(0, e_9), 0)</eqn>
			</aux>
			<aux name="e 9">
				<eqn>100</eqn>
			</aux>
			<flow name="Losing\nImmunity">
				<eqn>Recovered/
Average_Length_of_Immunity</eqn>
				<non_negative/>
				<units>People/Months</units>
			</flow>
			<aux name="Average\nLength\nof Immunity">
				<eqn>INIT(RANDOM(1, 36))</eqn>
				<units>Months</units>
			</aux>
		</variables>
