	<model>
		<variables>
			<stock name="Potential\nUsers">
				<eqn>Initial_Potential_Users</eqn>
				<outflow>Adoption</outflow>
				<units>Users</units>
			</stock>
			<stock name="Users">
				<eqn>0</eqn>
				<inflow>Adoption</inflow>
				<units>Users</units>
			</stock>
			<flow name="Adoption">
				<eqn>Innovation + 
Imitation</eqn>
				<non_negative/>
				<units>Users/Month</units>
			</flow>
			<aux name="Coefficient\nof Innovation">
				<eqn>INIT(RANDOM(0.01, 0.1))</eqn>
				<units>1/Months</units>
			</aux>
			<aux name="Coefficient\nof Imitation">
				<eqn>INIT(RANDOM(0.1, 0.9))</eqn>
				<units>1/Months</units>
			</aux>
			<aux name="Imitation">
				<eqn>Coefficient_of_Imitation*
Potential_Users*Users/
(Users+Potential_Users)</eqn>
				<units>Users/Month</units>
			</aux>
			<aux name="Innovation">
				<eqn>Coefficient_of_Innovation*
Potential_Users</eqn>
				<units>Users/Month</units>
			</aux>
			<aux name="Initial\nPotential\nUsers">
				<eqn>INIT(RANDOM(1000, 1E6))</eqn>
				<units>Users</units>
			</aux>
			<aux name="F">
				<eqn>Users/Initial_Potential_Users</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Observed\nPotential\nUsers 1">
				<eqn>MAX(Potential_Users + NORMAL(0, e_1), 0)</eqn>
			</aux>
			<aux name="e 1">
				<eqn>10000</eqn>
			</aux>
			<aux name="Observed\nPotential\nUsers 2">
				<eqn>MAX(Potential_Users + NORMAL(0, e_2), 0)</eqn>
			</aux>
			<aux name="e 2">
				<eqn>10000</eqn>
			</aux>
			<aux name="Observed\nPotential\nUsers 3">
				<eqn>MAX(Potential_Users + NORMAL(0, e_3), 0)</eqn>
			</aux>
			<aux name="e 3">
				<eqn>10000</eqn>
			</aux>
			<aux name="e 4">
				<eqn>10000</eqn>
			</aux>
			<aux name="Observed\nUsers 1">
				<eqn>MAX(Users + NORMAL(0, e_4), 0)</eqn>
			</aux>
			<aux name="e 5">
				<eqn>10000</eqn>
			</aux>
			<aux name="Observed\nUsers 2">
				<eqn>MAX(Users + NORMAL(0, e_5), 0)</eqn>
			</aux>
			<aux name="e 6">
				<eqn>10000</eqn>
			</aux>
			<aux name="Observed\nUsers 3">
				<eqn>MAX(Users + NORMAL(0, e_6), 0)</eqn>
			</aux>
		</variables>
