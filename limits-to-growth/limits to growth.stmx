	<model_units/>
	<model>
		<isee:extra_collection_variables>
			<isee:extra_collection_variable name="Population"/>
		</isee:extra_collection_variables>
		<variables>
			<stock name="Population">
				<eqn>Initial_Population</eqn>
				<inflow>Births</inflow>
				<outflow>Deaths</outflow>
			</stock>
			<flow name="Births">
				<eqn>Max_Crude_Birth_Rate*Effect_of_Population_Size_on_Births*Population</eqn>
			</flow>
			<aux name="Population\nFraction">
				<eqn>Population/Carrying_Capacity</eqn>
			</aux>
			<aux name="Carrying\nCapacity">
				<eqn>INIT(RANDOM(20,  200, Habitat_Type))</eqn>
			</aux>
			<aux name="Effect of\nPopulation\nSize on\nBirths">
				<eqn>MAX(1-Population_Fraction, 0)</eqn>
			</aux>
			<flow name="Deaths">
				<eqn>Mortality_Risk*Population</eqn>
			</flow>
			<aux name="Mortality\nRisk">
				<eqn>0.05</eqn>
				<format precision="auto"/>
				<range min="0.01" max="1"/>
			</aux>
			<aux name="Max Crude\nBirth Rate">
				<eqn>0.15</eqn>
				<format precision="auto"/>
				<range min="0.05" max="2"/>
			</aux>
			<aux name="Initial\nPopulation">
				<eqn>1</eqn>
				<format precision="auto"/>
				<range min="0" max="200"/>
			</aux>
			<aux name="Habitat\nType">
				<eqn>1</eqn>
				<range min="0" max="20"/>
			</aux>
		</variables>
