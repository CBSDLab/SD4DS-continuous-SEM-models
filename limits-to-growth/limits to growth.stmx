			<view background="white" page_width="788" page_height="528" home_view="true" type="interface">
				<style>
					<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				</style>
				<button label="Run simulation" isee:tooltip="Click to run 100 simulations" x="473" y="493">
					<actions>
						<action isee:analysis_index="0">run_sensitivity</action>
					</actions>
				</button>
				<stacked_container x="442" y="124" width="328" height="336">
					<graph legend_position="none" width="328" height="336" comparative="true" type="time_series" show_grid="false" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="3" isee:fill_intensity="0.1" isee:allow_zero_axis="true" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true">
						<plot isee:immediately_update_on_user_input="true" color="blue" isee:keep_zero_visible="true" pen_width="1" index="0" show_y_axis="true">
							<entity name="Population"/>
						</plot>
					</graph>
				</stacked_container>
				<button label="Clear results" isee:tooltip="" x="640" y="493">
					<actions>
						<action>restore_all</action>
					</actions>
				</button>
				<button label="Export" isee:tooltip="Click to download runs in wide format" x="552.5" y="493">
					<actions>
						<action interval="0.1" orientation="vertical" comparative="true" use_actual_variable_names="true" type="export_data">
							<entity name="Population"/>
							<entity name="Births"/>
							<entity name="Deaths"/>
							<entity name="Carrying_Capacity"/>
							<entity name="Effect_of_Population_Size_on_Births"/>
							<entity name="Initial_Population"/>
							<entity name="Max_Crude_Birth_Rate"/>
							<entity name="Mortality_Risk"/>
							<entity name="Population_Fraction"/>
						</action>
					</actions>
				</button>
				<isee:model_view x="37" y="126" width="379" height="332" zoom="0.75" center_x="368.426" center_y="221.333" locked_view="true" transparent="true" show_ltm_table="false">
					<model name="Top-Level"/>
					<isee:highlight_list/>
				</isee:model_view>
				<text_box x="22" y="23" width="743" height="85">The Limits to Growth system dynamics model simulates the population of a species across 100 habitats of different types with varying carrying capacity to support the population. Click [Run simulation] to generate a new synthetic data set with normally randomly distributed parameters of Max Crude Birth Rate, Mortality Risks, and initial Population. Click [Export] to download a .csv file in wide format with all 100 runs. Click [Clear results] to clear the graph. Note that this is not needed if generating multiple sets of 100 habitats as each set is generated from new random parameters. </text_box>
			</view>
			<isee:templates>
				<view background="white" page_width="788" page_height="528" type="template">
					<style>
						<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
					</style>
				</view>
			</isee:templates>
			<isee:stories/>
		</views>
	</model>
</xmile>

