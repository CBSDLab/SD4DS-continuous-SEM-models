		<isee:sensi_specs name="Generate population over set of habitats" method="multivariate" runs="401">
			<isee:variable type="normal" mean="0.05" std_dev="0.1" min="0.01" max="1" name="Mortality_Risk" num_samples="100"/>
			<isee:variable type="normal" mean="0.25" std_dev="0.39" min="0.05" max="2" name="Max_Crude_Birth_Rate" num_samples="100"/>
			<isee:variable type="uniform" min="1" max="120" name="Initial_Population" num_samples="100"/>
			<isee:variable type="uniform" min="1" max="20" seed="12345" name="Habitat_Type" num_samples="100"/>
		</isee:sensi_specs>
