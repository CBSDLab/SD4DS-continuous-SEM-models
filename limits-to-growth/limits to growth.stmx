	<model>
		<isee:extra_collection_variables>
			<isee:extra_collection_variable name="Population"/>
		</isee:extra_collection_variables>
		<variables>
			<stock name="Population">
				<eqn>1</eqn>
				<inflow>Births</inflow>
				<outflow>Deaths</outflow>
				<non_negative/>
			</stock>
			<flow name="Births">
				<eqn>Max_Crude_Birth_Rate*Effect_of_Population_Size_on_Births*Population</eqn>
				<non_negative/>
			</flow>
			<aux name="Population\nFraction">
				<eqn>Population/Carrying_Capacity</eqn>
			</aux>
			<aux name="Carrying Capacity">
				<eqn>100</eqn>
			</aux>
			<aux name="Effect of\nPopulation\nSize on\nBirths">
				<eqn>1-Population_Fraction</eqn>
			</aux>
			<flow name="Deaths">
				<eqn>Max_Mortality_Rate*Population</eqn>
				<non_negative/>
			</flow>
			<aux name="Max Mortality\nRate">
				<eqn>0.05</eqn>
			</aux>
			<aux name="Max Crude\nBirth Rate">
				<eqn>0.15</eqn>
			</aux>
		</variables>
